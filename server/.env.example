# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Replace with your MongoDB Atlas connection string in production
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/police_complaint_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_police_complaint_db

# JWT Secret & Expiry
JWT_SECRET=police_complaint_super_secret_jwt_key_2026_secured
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (For Database Seeding)
INITIAL_ADMIN_USERNAME=harsha
INITIAL_ADMIN_EMAIL=harsha@policeportal.gov.in
INITIAL_ADMIN_PASSWORD=harsha@123

# Cloudinary Storage (Optional - falls back to secure local storage if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notification Service (Optional - SMTP settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Police Portal <no-reply@policeportal.gov.in>"
